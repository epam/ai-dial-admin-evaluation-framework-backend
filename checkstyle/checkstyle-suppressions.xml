<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <suppress files="build[\\/]generated[\\/].*" checks=".*"/>
    <suppress files="src[\\/]main[\\/]java-generated[\\/].*" checks=".*"/>
    <!-- Flyway Java migration class names follow Flyway's V<major>_<minor>__<Description>
         convention (underscore = version separator), which TypeName's default
         "^[A-Z][a-zA-Z0-9]*$" pattern rejects. Scoped to this one file rather than loosening
         the project-wide rule. -->
    <suppress
            files="src[\\/]main[\\/]java[\\/]com[\\/]epam[\\/]aidial[\\/]evaluation[\\/]configuration[\\/]datasource[\\/]migration[\\/]V1_33__CopyRunMetricSnapshotsFromAnalytics\.java"
            checks="TypeName"/>
</suppressions>
